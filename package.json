{
  "name": "react-dropdown-select",
  "version": "4.12.2",
  "packageManager": "pnpm@9.15.4",
  "description": "Customizable dropdown select for react",
  "main": "dist/react-dropdown-select.js",
  "module": "lib/index.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "lib",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "types": "tsc --emitDeclarationOnly",
    "test": "jest --bail",
    "test:watch": "jest --bail --watch",
    "coveralls": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "build": "tsc --noEmit && webpack && pnpm run transpile && pnpm run types && bundlesize",
    "transpile": "babel src --out-dir lib --extensions .ts,.tsx",
    "prepublishOnly": "pnpm run build",
    "// ℹ️ ------- versioning and release -------": "",
    "commit": "cz",
    "changelog": "npx git-cliff@latest --output CHANGELOG.md",
    "version": "pnpm run changelog && git add CHANGELOG.md",
    "release:major": "pnpm run version:major && pnpm run commit:changelog",
    "version:major": "npm version major --no-git-tag-version",
    "release:minor": "pnpm run version:minor && pnpm run commit:changelog",
    "version:minor": "npm version minor --no-git-tag-version",
    "release:patch": "pnpm run version:patch && pnpm run commit:changelog",
    "version:patch": "npm version patch --no-git-tag-version",
    "commit:changelog": "node -e \"const v=require('./package.json').version; const {execSync}=require('child_process'); execSync('git add -A'); execSync('git commit -m \\\"chore: release v'+v+'\\\"'); execSync('git tag v'+v); execSync('git push && git push --tags');\"",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "bundlesize": "npx bundlesize"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanusart/react-dropdown-select"
  },
  "bundlesize": [
    {
      "path": "./dist/react-dropdown-select.js",
      "maxSize": "20 kB"
    },
    {
      "path": "./lib/index.js",
      "maxSize": "20 kB"
    }
  ],
  "keywords": [
    "react",
    "react component",
    "select",
    "multiselect",
    "dropdown"
  ],
  "author": "Sasha Khamkov <sanusart@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.x",
    "react-dom": ">=16.x"
  },
  "devDependencies": {
    "@babel/cli": "^7.7.7",
    "@babel/core": "^7.7.7",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.7.7",
    "@babel/plugin-syntax-dynamic-import": "^7.7.4",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.4",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@storybook/addon-docs": "7.1.1",
    "@storybook/addon-essentials": "7.1.1",
    "@storybook/addon-interactions": "7.1.1",
    "@storybook/addon-links": "7.1.1",
    "@storybook/blocks": "7.1.1",
    "@storybook/react": "7.1.1",
    "@storybook/react-webpack5": "7.1.1",
    "@storybook/testing-library": "^0.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^25.3.0",
    "babel-loader": "^8.0.6",
    "babel-plugin-transform-dynamic-import": "^2.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-preset-minify": "^0.5.1",
    "bundlesize": "1.0.0-beta.2",
    "commitizen": "^4.3.1",
    "coveralls": "^3.0.9",
    "css-loader": "^6.7.3",
    "cz-conventional-changelog": "^3.3.0",
    "gh-pages": "^2.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "29.6.2",
    "jest-environment-jsdom": "29.6.2",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "react": "16.14.0",
    "react-dom": "^16.12.0",
    "react-test-renderer": "^16.12.0",
    "storybook": "7.1.1",
    "style-loader": "^3.3.1",
    "typescript": "^5.9.3",
    "webpack": "5.88.1",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "4.15.1"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|ts|tsx)$": "babel-jest"
    },
    "testMatch": [
      "**/?(*.)+(spec|test).js?(x)"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "collectCoverage": false,
    "bail": true,
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/ClickOutside.tsx",
      "!node_modules/**",
      "!docs/**",
      "!dist/**",
      "!coverage/**"
    ]
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "ie 11"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
