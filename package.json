{
  "name": "react-dropdown-select-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "Customizable dropdown select for react — monorepo root",
  "scripts": {
    "typecheck": "pnpm --filter react-dropdown-select run typecheck && pnpm --filter docs-site run typecheck",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "prettier": "prettier --check \"packages/react-dropdown-select/src\" \"packages/docs-site/src\"",
    "prettier:write": "prettier --write \"packages/react-dropdown-select/src\" \"packages/docs-site/src\"",
    "test": "pnpm --filter react-dropdown-select run test",
    "build": "pnpm --filter react-dropdown-select run build",
    "// ℹ️ ------- versioning and release -------": "",
    "commit": "cz",
    "changelog": "npx git-cliff@latest --output CHANGELOG.md",
    "release:major": "pnpm --filter react-dropdown-select run release:major",
    "release:minor": "pnpm --filter react-dropdown-select run release:minor",
    "release:patch": "pnpm --filter react-dropdown-select run release:patch",
    "storybook": "pnpm --filter react-dropdown-select run storybook",
    "build-storybook": "pnpm --filter react-dropdown-select run build-storybook",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanusart/react-dropdown-select"
  },
  "keywords": [
    "react",
    "react component",
    "select",
    "multiselect",
    "dropdown"
  ],
  "author": "Sasha Khamkov <sanusart@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.65.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "^10.0.0"
      }
    }
  }
}
