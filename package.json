{
  "name": "react-dropdown-select",
  "version": "4.12.2",
  "description": "Customizable dropdown select for react",
  "main": "dist/react-dropdown-select.js",
  "module": "lib/index.js",
  "types": "types.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "lib",
    "types.d.ts"
  ],
  "scripts": {
    "test": "jest --bail",
    "test:watch": "jest --bail --watch",
    "coveralls": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "build:ts": "tsc",
    "ts-check": "tsc --noEmit",
    "build": "webpack && pnpm run transpile && pnpm run build:ts",
    "transpile": "babel src -d lib",
    "prepublishOnly": "pnpm run build",
    "version": "replace \"vPLACEHOLDER\" \"v$npm_package_version\" ./CHANGELOG.md && git add .",
    "preversion": "sh change-log-builder.sh",
    "release:patch": "pnpm version patch -m \"v%s \nSee changelog: https://github.com/sanusart/react-dropdown-select/blob/master/CHANGELOG.md\"",
    "release:minor": "pnpm version minor -m \"v%s \nSee changelog: https://github.com/sanusart/react-dropdown-select/blob/master/CHANGELOG.md\"",
    "release:major": "pnpm version major -m \"v%s \nSee changelog: https://github.com/sanusart/react-dropdown-select/blob/master/CHANGELOG.md\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",

    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanusart/react-dropdown-select"
  },
  "bundlesize": [
    {
      "path": "./dist/react-dropdown-select.js",
      "maxSize": "20 kB"
    },
    {
      "path": "./lib/index.js",
      "maxSize": "20 kB"
    }
  ],
  "keywords": [
    "react",
    "react component",
    "select",
    "multiselect",
    "dropdown"
  ],
  "author": "Sasha Khamkov <sanusart@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "prop-types": ">=15.7.2",
    "react": ">=16.x",
    "react-dom": ">=16.x"
  },
  "devDependencies": {
    "@babel/cli": "^7.7.7",
    "@babel/core": "^7.7.7",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.7.7",
    "@babel/plugin-syntax-dynamic-import": "^7.7.4",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.4",
    "@emotion/babel-plugin": "11.11.0",
    "@emotion/jest": "11.11.0",
    "@storybook/addon-docs": "7.1.1",
    "@storybook/addon-essentials": "7.1.1",
    "@storybook/addon-interactions": "7.1.1",
    "@storybook/addon-links": "7.1.1",
    "@storybook/blocks": "7.1.1",
    "@storybook/react": "7.1.1",
    "@storybook/react-webpack5": "7.1.1",
    "@storybook/testing-library": "^0.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^25.3.0",
    "babel-loader": "^8.0.6",
    "babel-plugin-transform-dynamic-import": "^2.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-preset-minify": "^0.5.1",
    "bundlesize": "1.0.0-beta.2",
    "coveralls": "^3.0.9",
    "css-loader": "^6.7.3",
    "gh-pages": "^2.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^3.1.0",
    "jest": "29.6.2",
    "jest-environment-jsdom": "29.6.2",
    "prettier": "^2.8.8",
    "replace": "^1.2.0",
    "style-loader": "^3.3.1",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.3",
    "webpack": "5.88.1",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "4.15.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "@typescript-eslint/parser": "^6.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "@babel/preset-typescript": "^7.22.5"
  },
  "dependencies": {
    "@emotion/react": "11.11.0",
    "@emotion/styled": "11.11.0"
  },
  "jest": {
    "snapshotSerializers": [
      "@emotion/jest/serializer"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "testMatch": [
      "**/?(*.)+(spec|test).js?(x)"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "collectCoverage": false,
    "bail": true,
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/ClickOutside.js",
      "!node_modules/**",
      "!docs/**",
      "!dist/**",
      "!coverage/**"
    ]
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "ie 11"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "pnpm ts-check && pnpm lint && pnpm test"
    }
  }
}
