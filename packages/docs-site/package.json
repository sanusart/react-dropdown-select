{
  "name": "docs-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "http://sanusart.github.io/react-dropdown-select/",
  "scripts": {
    "predev": "pnpm --filter react-dropdown-select types",
    "dev": "vite",
    "prebuild": "pnpm --filter react-dropdown-select types",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter react-dropdown-select types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier --check src",
    "prettier:write": "prettier --write src"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-dropdown-select": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
