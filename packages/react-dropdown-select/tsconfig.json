{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["DOM", "ES2015"],
    "jsx": "react",
    "declaration": true,
    "declarationDir": "types",
    "moduleResolution": "node",
    "outDir": "lib",
    "sourceMap": true,
    "baseUrl": "."
